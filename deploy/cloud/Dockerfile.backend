# syntax=docker/dockerfile:1
# Linux 后端镜像。构建时必须指定 --platform linux/amd64。
#
# 构建阶段与运行阶段都基于 Swift 官方镜像：运行阶段复用同一镜像可以保证
# Swift 运行时动态库齐全，代价是体积约 2.5 GB。等部署验证通过后再考虑裁剪。

FROM swift:6.1.3-noble AS build

# python3-pil 是 Resources/Linux/image-helper.py 的前置依赖。
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3-pil \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Package.swift 里定义了 testTargets，SPM 加载 manifest 时会校验目录存在。
# 缺 Tests/ 会直接报错，哪怕 swift build 并不编译测试，所以必须一起复制。
COPY Package.swift ./
COPY Sources ./Sources
COPY Tests ./Tests
COPY Resources ./Resources

RUN swift build -c release --jobs 2

# 输出布局与 scripts/build-linux.sh 保持一致：二进制叫 dafeiyu，Resources 放在它旁边。
RUN mkdir -p /out/Resources \
 && cp "$(swift build -c release --show-bin-path)/WeChatAIBot" /out/dafeiyu \
 && cp -R Resources/QQControl Resources/QQStickers Resources/Linux /out/Resources/


FROM swift:6.1.3-noble AS runtime

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tzdata python3-pil \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /out /app

# 家目录用 /srv/dafeiyu 而不是默认的 /home/dafeiyu，避免与宿主机的目录约定混淆。
# /data 是持久化挂载点，必须让运行用户可写，否则 state.json 写不进去。
RUN useradd --system --uid 10001 --create-home --home-dir /srv/dafeiyu dafeiyu \
 && mkdir -p /data \
 && chown -R dafeiyu:dafeiyu /app /data

USER dafeiyu

# DAFEIYU_DATA_DIR 决定 state.json 的位置（Services.swift:66）。
# 不设它就会落到容器可写层，down 后重建即丢失配置、记忆与额度计数。
# DAFEIYU_RESOURCES 显式指向 Resources，不依赖 argv[0] 的路径推导。
ENV TZ=Asia/Shanghai \
    HOME=/srv/dafeiyu \
    DAFEIYU_DATA_DIR=/data \
    DAFEIYU_RESOURCES=/app/Resources

ENTRYPOINT ["/app/dafeiyu"]
